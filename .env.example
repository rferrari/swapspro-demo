# Your integrator id. Attribution only: no signup, no API key, no account.
# Stamped on every quote this app asks for. Up to 64 characters.
NEXT_PUBLIC_SWAPSPRO_PARTNER=swapspro-demo

# Optional additive partner fee in basis points, capped at 100 (1%) by the API.
# Only some venues can carry a second fee — the quote response says which.
# Read /fees before setting this to anything but 0.
NEXT_PUBLIC_SWAPSPRO_FEE_BPS=0
